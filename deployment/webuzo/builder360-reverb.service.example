[Unit]
Description=Builder360 Reverb Server
After=network.target

[Service]
Type=simple
User=WEBUZO_USER
Group=WEBUZO_USER
WorkingDirectory=/home/WEBUZO_USER/public_html/builder360
ExecStart=/usr/bin/php artisan reverb:start --host=127.0.0.1 --port=8080
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
