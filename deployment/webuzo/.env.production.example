APP_NAME="Builder360 ERP CRM"
APP_ENV=production
APP_KEY=base64:GENERATE_ON_SERVER
APP_DEBUG=false
APP_URL=https://erp.example.com
APP_TIMEZONE=Asia/Kolkata

BUILDER360_SINGLE_COMPANY=true
BUILDER360_COMPANY_CODE=B360D
BUILDER360_DEMO_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=builder360
DB_USERNAME=builder360_app
DB_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD

CACHE_STORE=database
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=local
FILESYSTEM_LOCAL_SERVE=false

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=REPLACE_WITH_SMTP_USER
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM_ADDRESS=erp@example.com
MAIL_FROM_NAME="${APP_NAME}"

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=REPLACE_WITH_RANDOM_ID
REVERB_APP_KEY=REPLACE_WITH_RANDOM_KEY
REVERB_APP_SECRET=REPLACE_WITH_RANDOM_SECRET
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_HOST=erp.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_ALLOWED_ORIGINS=erp.example.com

BUILDER360_SCHEDULER_ENABLED=true
BUILDER360_SCHEDULER_TIMEZONE=Asia/Kolkata

BUILDER360_EXTERNAL_DB_BACKUP_VERIFIED=false
BUILDER360_EXTERNAL_DB_BACKUP_PROVIDER=Webuzo-or-approved-provider
BUILDER360_EXTERNAL_DB_BACKUP_RUNBOOK=docs/WEBUZO_UBUNTU_DEPLOYMENT.md
BUILDER360_EXTERNAL_DB_BACKUP_RPO_MINUTES=1440
BUILDER360_EXTERNAL_DB_BACKUP_RTO_MINUTES=240
BUILDER360_EXTERNAL_DB_BACKUP_LAST_RESTORE_TESTED_AT=

BUILDER360_PAYMENT_GATEWAY_PROVIDER=REPLACE_WITH_APPROVED_PROVIDER
BUILDER360_PAYMENT_GATEWAY_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_WEBHOOK_SECRET

SECURITY_HEADER_HSTS_ENABLED=true
SECURITY_HEADER_HSTS_MAX_AGE=31536000
SECURITY_HEADER_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HEADER_HSTS_PRELOAD=false
SECURITY_HEADER_CSP="default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self' wss://erp.example.com; upgrade-insecure-requests"
SECURITY_EXCEPTION_INCLUDE_DEBUG_DETAILS=false
