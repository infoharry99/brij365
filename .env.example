APP_NAME="Builder360 ERP CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

BUILDER360_SINGLE_COMPANY=true
BUILDER360_COMPANY_CODE=B360D

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

SECURITY_HEADER_FRAME_OPTIONS=SAMEORIGIN
SECURITY_HEADER_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_HEADER_COOP=same-origin
SECURITY_HEADER_PERMISSIONS_POLICY="camera=(), microphone=(), geolocation=(self), payment=(), usb=(), browsing-topics=()"
SECURITY_HEADER_CSP="default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; upgrade-insecure-requests"
SECURITY_HEADER_HSTS_ENABLED=true
SECURITY_HEADER_HSTS_MAX_AGE=31536000
SECURITY_HEADER_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HEADER_HSTS_PRELOAD=false
SECURITY_RATE_LIMIT_ERP_READ_PER_MINUTE=1200
SECURITY_RATE_LIMIT_ERP_WRITE_PER_MINUTE=600
SECURITY_RATE_LIMIT_ERP_READ_MIN_PER_MINUTE=1
SECURITY_RATE_LIMIT_ERP_READ_MAX_PER_MINUTE=5000
SECURITY_RATE_LIMIT_ERP_WRITE_MIN_PER_MINUTE=1
SECURITY_RATE_LIMIT_ERP_WRITE_MAX_PER_MINUTE=2500
SECURITY_EXCEPTION_JSON_REQUEST_ID_ENABLED=true
SECURITY_EXCEPTION_INCLUDE_DEBUG_DETAILS=false
SECURITY_EXCEPTION_GENERIC_SERVER_MESSAGE="An unexpected server error occurred. Provide the request_id to support."
SECURITY_PASSWORD_MIN_LENGTH=10
SECURITY_PASSWORD_MAX_LENGTH=255
SECURITY_PASSWORD_REQUIRE_MIXED_CASE=true
SECURITY_PASSWORD_REQUIRE_NUMBERS=true
SECURITY_PASSWORD_REQUIRE_SYMBOLS=true
SECURITY_PASSWORD_UNCOMPROMISED=false
SECURITY_PASSWORD_MAX_COMPROMISED_THRESHOLD=0
BUILDER360_DOCUMENT_ALLOWED_DISKS=local,s3
BUILDER360_DOCUMENT_STORAGE_PATH_PREFIX=documents/
BUILDER360_DOCUMENT_ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,doc,docx,xls,xlsx,csv
BUILDER360_DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv,text/plain
BUILDER360_DOCUMENT_MAX_FILE_SIZE_KB=10240
BUILDER360_DOCUMENT_MAX_FILE_SIZE_CEILING_KB=51200
BUILDER360_DOCUMENT_ALLOWED_CHECKSUM_ALGORITHMS=sha256
BUILDER360_REPORT_MAX_DATE_RANGE_DAYS=366
BUILDER360_REPORT_MAX_EXPORT_ROWS=500
BUILDER360_REPORT_MAX_EXPORT_ROWS_CEILING=5000
BUILDER360_PAYROLL_PERIOD_YEAR_MIN=2020
BUILDER360_PAYROLL_PERIOD_YEAR_MAX=2100
BUILDER360_PAYROLL_WORKING_DAYS_MIN=1
BUILDER360_PAYROLL_WORKING_DAYS_MAX=31
BUILDER360_PAGINATION_DEFAULT_PER_PAGE=15
BUILDER360_PAGINATION_WORKSPACE_PER_PAGE=25
BUILDER360_PAGINATION_LARGE_PER_PAGE=50
BUILDER360_PAGINATION_DEFAULT_MAX_PER_PAGE=50
BUILDER360_PAGINATION_LARGE_MAX_PER_PAGE=100
BUILDER360_PAGINATION_ABSOLUTE_MAX_PER_PAGE=100
BUILDER360_PAGINATION_ABSOLUTE_CEILING=250
BUILDER360_MONEY_ENTERPRISE_AMOUNT_MAX=999999999999.99
BUILDER360_MONEY_PAYMENT_AMOUNT_MAX=999999999999
BUILDER360_MONEY_HR_AMOUNT_MAX=999999999.99
BUILDER360_MONEY_CTC_AMOUNT_MAX=9999999999
BUILDER360_MONEY_MAINTENANCE_COST_MAX=9999999999.99
BUILDER360_MONEY_COMMISSION_FIXED_AMOUNT_MAX=99999999
BUILDER360_MONEY_COMMISSION_TARGET_AMOUNT_MAX=9999999999
BUILDER360_MONEY_ENTERPRISE_AMOUNT_CEILING=999999999999.99
BUILDER360_MONEY_HR_AMOUNT_CEILING=999999999.99
BUILDER360_MONEY_CTC_AMOUNT_CEILING=9999999999
BUILDER360_OPERATIONAL_PROCUREMENT_QUANTITY_MAX=9999999
BUILDER360_OPERATIONAL_CONSTRUCTION_QUANTITY_MAX=999999999
BUILDER360_OPERATIONAL_RATE_MAX=999999999
BUILDER360_OPERATIONAL_EQUIPMENT_HOURS_MAX=24
BUILDER360_OPERATIONAL_QUANTITY_CEILING=999999999
BUILDER360_OPERATIONAL_RATE_CEILING=999999999
BUILDER360_OPERATIONAL_EQUIPMENT_HOURS_CEILING=24
BUILDER360_REQUIRED_ROLE_SLUGS=director,sales_head,construction_head,finance_head,hr_manager,buyer,employee,payroll,recruiter,auditor,compliance,system_admin,channel_partner,executive_partner_broker
BUILDER360_REQUIRED_OPERATIONAL_ROLE_SLUGS=director,system_admin,auditor
BUILDER360_REQUIRED_ACTIVE_SETTING_KEYS=hr.attendance.rules,after_sales.sla_hours,workflow.approval_chains,governance.backup_dr,payroll.tax_rules,hr.leave.rules,payroll.commission_rules,finance.gst_rules,chat_connect.role_access
BUILDER360_REQUIRED_AUDIT_INDEXES=audit_events_user_created_index,audit_events_type_created_index,audit_events_auditable_created_index,audit_events_request_context_index
BUILDER360_AUDIT_MAX_ACTIVITY_AGE_HOURS=24
BUILDER360_REQUIRED_NOTIFICATION_INDEXES=notifications_recipient_created_index,notifications_recipient_status_created_index,notifications_recipient_category_status_index,notifications_recipient_severity_status_index
BUILDER360_NOTIFICATIONS_MAX_UNREAD_PER_USER=250
BUILDER360_NOTIFICATIONS_MAX_ACTIVITY_AGE_HOURS=24
BUILDER360_REQUIRED_PUBLIC_ASSETS=css/builder360-classic.css,js/builder360-classic.js
BUILDER360_PAYMENT_GATEWAY_PROVIDER=prototype
BUILDER360_PAYMENT_GATEWAY_WEBHOOK_SECRET=
# Required when running database seeders in production. Local/test environments
# fall back to the documented demo password if this value is omitted.
BUILDER360_DEMO_PASSWORD=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=builder360
DB_USERNAME=root
DB_PASSWORD=
DB_FOREIGN_KEYS=true

# Required when production/staging external database is used. These values
# document the externally managed database backup control for Webuzo/VPS or
# other hosted environments.
BUILDER360_EXTERNAL_DB_BACKUP_VERIFIED=false
BUILDER360_EXTERNAL_DB_BACKUP_PROVIDER=
BUILDER360_EXTERNAL_DB_BACKUP_RUNBOOK=
BUILDER360_EXTERNAL_DB_BACKUP_RPO_MINUTES=
BUILDER360_EXTERNAL_DB_BACKUP_RTO_MINUTES=
BUILDER360_EXTERNAL_DB_BACKUP_LAST_RESTORE_TESTED_AT=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=builder360-local
REVERB_APP_KEY=builder360-local-key
REVERB_APP_SECRET=builder360-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=127.0.0.1,localhost
FILESYSTEM_DISK=local
FILESYSTEM_LOCAL_SERVE=false
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAILBOX_CONNECTION_TIMEOUT=30
MAILBOX_INITIAL_MESSAGE_LIMIT=250
MAILBOX_SYNC_MESSAGE_LIMIT=500
MAILBOX_ATTACHMENT_MAX_KB=25600
MAILBOX_MALWARE_SCAN_REQUIRED=false
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
